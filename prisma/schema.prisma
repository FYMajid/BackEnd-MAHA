// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Position {
  CLIENT
  SENIOR_LAWYER
  JUNIOR_LAWYER
}

enum Role {
  USER
  ADMIN
}

enum ClientStatus {
  CLIENT
  NON_CLIENT
}

enum DocumentType {
  FILE
  FOLDER
}

enum MatterStatus {
  DONE
  IN_PROGRESS
  PENDING
}

enum CostJournalEntryType {
  EXPENSE
  TIME
}

enum CostJournalBillingType {
  BILLABLE
  NON_BILLABLE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
}

enum PaymentProofStatus {
  PENDING
  VERIFIED
}

enum DepositActionType {
  ADD
  REFUND
}

////////////////////////////////////////////////////
/// AUTH
////////////////////////////////////////////////////
  model User {
    id String @id @default(uuid())

    firstName  String
    middleName String?
    lastName   String

    email      String @unique
    phoneNumber String @unique
    password    String
    address     String?
    position    Position   @default(CLIENT)
    role        Role  @default(USER)


    matters Matter[] @relation("AttorneyMatters")
    createdAt DateTime @default(now())
  }


////////////////////////////////////////////////////
/// CONTACT
////////////////////////////////////////////////////

model Contact {
  id                String            @id @default(uuid())
  isClient          ClientStatus      @default(CLIENT)
  contactType       String            // Contoh: "Limited Liability Company", "Cooperative"
  name              String
  image             String?
  email             String?
  phoneNumber       String?
  address           String?
  additionalInfo    String?
  creator           String
  createdAt         DateTime          @default(now())

  // Relasi One-to-One ke 3 Kategori Utama
  personalDetail    PersonalDetail?
  businessDetail    BusinessDetail?
  organizationDetail OrganizationDetail?

  documents          Document[]          @relation("ContactDocuments")
  matters Matter[] @relation("ClientMatters")
  relatedMatters MatterRelatedContact[]
  invoices          Invoice[]           @relation("ContactInvoices")
  depositAccounts   DepositAccount[]    @relation("ContactDepositAccounts")
}

model PersonalDetail {
  id                String   @id @default(uuid())
  contactId         String   @unique
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  citizenship       String?
  identificationNo  String?
  office_position   String?
  gender            String?
  birthDate         DateTime?
  religion          String?
}

model BusinessDetail {
  id                String   @id @default(uuid())
  contactId         String   @unique
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  businessType      String?
  taxCode           String?
  commissioners     String?
  directors         String?
  shareholders      String?
  lawyers           String?
}

model OrganizationDetail {
  id                String   @id @default(uuid())
  contactId         String   @unique
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  structureType     String?  // Untuk membedakan tipe Foundation/Cooperative
  taxCode           String?
  maintainers       String?
  mentors           String?
  supervisors       String?
  members           String?
  lawyers           String?
}


////////////////////////////////////////////////////
/// DOCUMENT  
////////////////////////////////////////////////////



model Document {
  id                    String   @id @default(uuid())
  type                  DocumentType
  name                  String   

  parentId              String?
  parent                Document? @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Document[] @relation("DocumentHierarchy")
  
  // Foreign Key ke Contact
  contactId             String?
  contact               Contact?   @relation("ContactDocuments", fields: [contactId], references: [id], onDelete: SetNull)
  
  // Foreign Key ke Matter (Jika Anda sudah punya model Matter)
  matterId              String?
  matter        Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)
  // matter             Matter?    @relation(fields: [matterId], references: [id])

  physicalLocation      String?
  hyperlink             String?
  description           String?  @db.Text
  createdAt             DateTime @default(now()) @map("uploadDate")
  lastEdit              DateTime @updatedAt
  fileUrl               String?  
  fileSize              Int?
  isDeleted             Boolean  @default(false)

  @@index([parentId])
  @@index([parentId, name])
  @@map("documents")
}

////////////////////////////////////////////////////
///   MATTER  
////////////////////////////////////////////////////

model Matter {
  id                String       @id @default(uuid())
  
  // Matter Information
  clientId          String
  client            Contact      @relation("ClientMatters", fields: [clientId], references: [id])

  responsibleAttorneyId String
  responsibleAttorney   User     @relation("AttorneyMatters", fields: [responsibleAttorneyId], references: [id])
  members           String?      // Bisa dikembangkan menjadi tabel relasi jika perlu multi-user

  
  // Matter Classification
  caseArea          String
  caseType          String
  disputeResolution String
  description       String?      @db.Text
  
  // Detail Location
  address           String?
  
  // Matter Timeline
  status            MatterStatus @default(PENDING)
  startDate         DateTime?
  pendingDate       DateTime?
  closeDate         DateTime?

  // Additional
  paymentMethod     String?
  additionalInfo    String?
  
  documents         Document[]
  events            Event[]
  costJournals      CostJournal[]
  relatedContacts   MatterRelatedContact[]
  invoices          Invoice[]          @relation("MatterInvoices")
  depositAccounts   DepositAccount[]   @relation("MatterDepositAccounts")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("matters")
}

model MatterRelatedContact {
  id          String   @id @default(uuid())
  matterId    String
  contactId   String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  matter  Matter  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([matterId, contactId])
  @@map("matter_related_contacts")
}

model CostJournal {
  id              String                  @id @default(uuid())
  matterId        String
  matter          Matter                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  entryType       CostJournalEntryType
  billingType     CostJournalBillingType  @default(BILLABLE)
  category        String?
  entryDate       DateTime
  description     String?                 @db.Text
  quantity        Int?
  unitCost        Int?
  durationMinutes Int?
  hourlyRate      Int?
  totalCost       Int
  attachmentUrl   String?
  createdBy       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([matterId])
  @@index([entryType])
  @@index([billingType])
  @@index([entryDate])
  @@map("cost_journals")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNo     String        @unique
  clientId      String
  client        Contact       @relation("ContactInvoices", fields: [clientId], references: [id], onDelete: Cascade)
  matterId      String
  matter        Matter        @relation("MatterInvoices", fields: [matterId], references: [id], onDelete: Cascade)
  invoiceDate   DateTime
  dueDate       DateTime
  paymentTerms  String?
  description   String?       @db.Text
  notes         String?       @db.Text
  subtotal      Int
  taxPercent    Int           @default(0)
  taxAmount     Int           @default(0)
  totalAmount   Int
  status        InvoiceStatus @default(PENDING)
  items         InvoiceItem[]
  paymentProofs PaymentProof[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([matterId])
  @@index([invoiceDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  rate        Int
  amount      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentProof {
  id            String             @id @default(uuid())
  invoiceId      String
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentDate    DateTime
  amountPaid     Int
  paymentMethod  String?
  referenceNo    String?
  notes          String?            @db.Text
  fileUrl        String?
  status         PaymentProofStatus @default(PENDING)
  verifiedBy     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
  @@map("payment_proofs")
}

model DepositAccount {
  id                  String            @id @default(uuid())
  clientId            String
  client              Contact           @relation("ContactDepositAccounts", fields: [clientId], references: [id], onDelete: Cascade)
  matterId            String?
  matter              Matter?           @relation("MatterDepositAccounts", fields: [matterId], references: [id], onDelete: SetNull)
  amount              Int               @default(0)
  refundedAmount      Int               @default(0)
  lastTransactionDate DateTime
  paymentMethod       String?
  referenceNo         String?
  description         String?           @db.Text
  lastActionType      DepositActionType @default(ADD)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([clientId])
  @@index([matterId])
  @@index([lastTransactionDate])
  @@map("deposit_accounts")
}


model Event {
  id          String   @id @default(uuid())
  title       String
  categoryId  String
  category    EventCategory @relation(fields: [categoryId], references: [id])
  location    String?
  startTime   DateTime
  endTime     DateTime
  description String?  @db.Text
  
  // Relasi berdasarkan UI "Event Relation"
  matterId    String?
  matter      Matter?  @relation(fields: [matterId], references: [id])
  
  notification String? // Contoh: "15 minutes before"
  attendees    String? // Bisa disimpan sebagai JSON string atau string biasa
  repeat       String? // Contoh: "Daily", "Weekly"
  hyperlink    String?
  fileUrl      String? // Untuk Upload File di UI

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model EventCategory {
  id     String  @id @default(uuid())
  name   String  @unique // Contoh: "Sidang", "Meeting"
  color  String? // Untuk label warna di kalender
  events Event[]

  @@map("event_categories")
}
